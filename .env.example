# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/razorrecover_db
# For SQLite local fallback when postgres is not running:
# DATABASE_URL=sqlite+aiosqlite:///./razorrecover.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI / LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_123

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
