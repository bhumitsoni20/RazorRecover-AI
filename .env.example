# ==============================================================================
# RazorRecover AI - Production Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# In Production (Railway / Supabase / RDS): Use full PostgreSQL async connection string:
DATABASE_URL=postgresql+asyncpg://postgres:your_password@your_host:5432/railway
# In Local Development:
# DATABASE_URL=sqlite+aiosqlite:///./razorrecover.db

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
# In Production: Use remote Redis connection string from Railway or Upstash
REDIS_URL=redis://default:your_redis_password@your_redis_host:6379/0
# In Local Development:
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI Fallback
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Razorpay Test Mode & Webhook Credentials
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_TVxlSjEzulO7pK
RAZORPAY_KEY_SECRET=cejSyhRW1S8DDQ0ZnR4CCXYQ
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_123

# ------------------------------------------------------------------------------
# 5. Authentication & JWT Security
# ------------------------------------------------------------------------------
# REQUIRED IN PROD: Generate a strong 32+ character random secret (e.g. `openssl rand -hex 32`)
AUTH_SECRET=your-production-jwt-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 6. Initial Seed Credentials (Created on first boot)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@razorrecover.ai
INITIAL_ADMIN_PASSWORD=Admin@RazorRecover2026!
DEMO_MERCHANT_1_EMAIL=admin@razorrecover.ai
DEMO_MERCHANT_1_PASSWORD=DemoMerchant123!
DEMO_MERCHANT_2_EMAIL=merchant2@fashionhub.com
DEMO_MERCHANT_2_PASSWORD=DemoMerchant123!

# ------------------------------------------------------------------------------
# 7. Application & Network Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000

# Frontend URL (For backend redirect/dashboard links)
FRONTEND_URL=https://razorrecover.vercel.app

# Allowed CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=https://razorrecover.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# 8. Frontend Public Configuration (Used on Vercel)
# ------------------------------------------------------------------------------
# Note: On Vercel, this must point to your live Railway backend URL
NEXT_PUBLIC_API_URL=https://your-backend-service.up.railway.app/api
